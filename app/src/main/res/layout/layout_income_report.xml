<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/income_report_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/income_header"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="#4CAF50"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_revert"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="24dp"
            android:text="Income Report"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/label_store_sales"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="STORE SALES"
                android:textColor="#4CAF50"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="8dp"
                android:background="#F5F5F5"/>

            <LinearLayout
                android:id="@+id/header_store_sales"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#EEEEEE"
                android:padding="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.6" android:text="Seller" android:textColor="#333333" android:textStyle="bold" android:textSize="11sp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:text="Product" android:textColor="#333333" android:textStyle="bold" android:textSize="11sp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.4" android:text="Qty" android:textColor="#333333" android:textStyle="bold" android:textSize="11sp" android:gravity="center"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.7" android:text="Date &amp; Time" android:textColor="#333333" android:textStyle="bold" android:textSize="11sp" android:gravity="center"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.5" android:text="Cost" android:textColor="#333333" android:textStyle="bold" android:textSize="11sp" android:gravity="right"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.5" android:text="Sale" android:textColor="#333333" android:textStyle="bold" android:textSize="11sp" android:gravity="right"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/incomeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/label_finance_income"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OTHER INCOME (FINANCE)"
                android:textColor="#4CAF50"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="8dp"
                android:background="#F5F5F5"/>

            <LinearLayout
                android:id="@+id/header_finance_income"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#EEEEEE"
                android:padding="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3" android:text="Description" android:textColor="#333333" android:textStyle="bold" android:textSize="11sp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.8" android:text="Date &amp; Time" android:textColor="#333333" android:textStyle="bold" android:textSize="11sp" android:gravity="center"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Amount" android:textColor="#333333" android:textStyle="bold" android:textSize="11sp" android:gravity="right"/>
                <View android:layout_width="32dp" android:layout_height="0dp"/> <!-- Spacer for note icon -->
            </LinearLayout>

            <LinearLayout
                android:id="@+id/financeIncomeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/label_loading_profits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LOADING PROFITS"
                android:textColor="#4CAF50"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="8dp"
                android:background="#F5F5F5"/>

            <LinearLayout
                android:id="@+id/header_loading_profits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#EEEEEE"
                android:padding="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.8" android:text="Category" android:textColor="#333333" android:textStyle="bold" android:textSize="11sp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Sub-Category" android:textColor="#333333" android:textStyle="bold" android:textSize="11sp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Date &amp; Time" android:textColor="#333333" android:textStyle="bold" android:textSize="11sp" android:gravity="center"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.6" android:text="Amount" android:textColor="#333333" android:textStyle="bold" android:textSize="11sp" android:gravity="right"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/loadingIncomeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#4CAF50" />

    <LinearLayout
        android:id="@+id/income_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#F5F5F5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/text_income_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TOTAL INCOME"
                android:textColor="#333333"
                android:textStyle="bold"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/text_total_income"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱0.00"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TOTAL PROFITS"
                android:textColor="#333333"
                android:textStyle="bold"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/text_total_profits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱0.00"
                android:textColor="#4CAF50"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
