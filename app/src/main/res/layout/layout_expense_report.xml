<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/expense_report_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/expense_header"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="#F44336"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_revert"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="24dp"
            android:text="Expense Report"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/label_staff_salary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="STAFF WORK LOGS (SALARY)"
                android:textColor="#E91E63"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="8dp"
                android:background="#F5F5F5"/>

            <LinearLayout
                android:id="@+id/header_staff_salary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#EEEEEE"
                android:padding="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:text="Name" android:textColor="#333333" android:textStyle="bold" android:textSize="11sp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.6" android:text="Hrs" android:textColor="#333333" android:textStyle="bold" android:textSize="11sp" android:gravity="center"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.8" android:text="Date" android:textColor="#333333" android:textStyle="bold" android:textSize="11sp" android:gravity="center"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.8" android:text="Amount" android:textColor="#333333" android:textStyle="bold" android:textSize="11sp" android:gravity="right"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/staffWorkContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/label_inventory_restock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="INVENTORY RESTOCK"
                android:textColor="#F44336"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="8dp"
                android:background="#F5F5F5"/>

            <LinearLayout
                android:id="@+id/header_inventory_restock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#EEEEEE"
                android:padding="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3" android:text="Product" android:textColor="#333333" android:textStyle="bold" android:textSize="11sp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.4" android:text="Qty" android:textColor="#333333" android:textStyle="bold" android:textSize="11sp" android:gravity="center"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.8" android:text="Date" android:textColor="#333333" android:textStyle="bold" android:textSize="11sp" android:gravity="center"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Amount" android:textColor="#333333" android:textStyle="bold" android:textSize="11sp" android:gravity="right"/>
                <View android:layout_width="32dp" android:layout_height="0dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/restockContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/label_rouzsean_use"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ROUZSEAN USE (PRODUCT/MONEY)"
                android:textColor="#9C27B0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="8dp"
                android:background="#F5F5F5"/>

            <LinearLayout
                android:id="@+id/header_rouzsean_use"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#EEEEEE"
                android:padding="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3" android:text="Description" android:textColor="#333333" android:textStyle="bold" android:textSize="11sp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.4" android:text="Qty" android:textColor="#333333" android:textStyle="bold" android:textSize="11sp" android:gravity="center"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.8" android:text="Date" android:textColor="#333333" android:textStyle="bold" android:textSize="11sp" android:gravity="center"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Amount" android:textColor="#333333" android:textStyle="bold" android:textSize="11sp" android:gravity="right"/>
                <View android:layout_width="32dp" android:layout_height="0dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ownerUseContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/label_finance_expense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OTHER EXPENSES (FINANCE)"
                android:textColor="#F44336"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="8dp"
                android:background="#F5F5F5"/>

            <LinearLayout
                android:id="@+id/header_finance_expense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#EEEEEE"
                android:padding="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3" android:text="Category" android:textColor="#333333" android:textStyle="bold" android:textSize="11sp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.8" android:text="Date" android:textColor="#333333" android:textStyle="bold" android:textSize="11sp" android:gravity="center"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Amount" android:textColor="#333333" android:textStyle="bold" android:textSize="11sp" android:gravity="right"/>
                <View android:layout_width="32dp" android:layout_height="0dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/financeExpenseContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/label_loading_restocks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LOADING RESTOCKS"
                android:textColor="#F44336"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="8dp"
                android:background="#F5F5F5"/>

            <LinearLayout
                android:id="@+id/header_loading_restocks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#EEEEEE"
                android:padding="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Category" android:textColor="#333333" android:textStyle="bold" android:textSize="11sp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Date" android:textColor="#333333" android:textStyle="bold" android:textSize="11sp" android:gravity="center"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.8" android:text="Amount" android:textColor="#333333" android:textStyle="bold" android:textSize="11sp" android:gravity="right"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/loadingRestockContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F44336" />

    <LinearLayout
        android:id="@+id/expense_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#F5F5F5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/text_expense_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TOTAL BUSINESS EXPENSE"
                android:textColor="#333333"
                android:textStyle="bold"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/text_total_expense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱0.00"
                android:textColor="#F44336"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TOTAL OWNER WITHDRAWAL/USE"
                android:textColor="#333333"
                android:textStyle="bold"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/text_total_owner_use"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱0.00"
                android:textColor="#9C27B0"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
