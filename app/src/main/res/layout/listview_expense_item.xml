<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextView
        android:id="@+id/text_expense_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.3"
        android:textSize="13sp"
        android:textColor="#333333"
        android:singleLine="false"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/text_expense_qty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.4"
        android:textSize="11sp"
        android:gravity="center"
        android:textColor="#666666"/>

    <TextView
        android:id="@+id/text_expense_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.8"
        android:textSize="11sp"
        android:gravity="center"
        android:textColor="#666666"/>

    <TextView
        android:id="@+id/text_expense_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:gravity="right"
        android:textStyle="bold"
        android:textColor="#F44336"/>

    <View android:layout_width="32dp" android:layout_height="0dp"
        android:id="@+id/spacer_note"/>

    <ImageView
        android:id="@+id/btn_note"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="8dp"
        android:src="@android:drawable/ic_menu_info_details"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Note"/>

</LinearLayout>
