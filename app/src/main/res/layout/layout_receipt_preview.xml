<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/receipt_preview_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E0E0E0">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/receipt_header"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="#3F51B5"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:id="@+id/receipt_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RECEIPT OPTIONS"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/receipt_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#CCCCCC"
        android:padding="16dp">

        <!-- The "Paper" Receipt -->
        <LinearLayout
            android:id="@+id/receipt_paper"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp"
            android:elevation="8dp">

            <!-- Logo/Store Name -->
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_launcher"
                android:scaleType="fitCenter"
                android:contentDescription="Store Logo"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ROUZSEAN VARIETY STORE"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:typeface="monospace"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/text_receipt_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="123 Business Road, City"
                android:textColor="#000000"
                android:textSize="12sp"
                android:gravity="center"
                android:typeface="monospace" />

            <TextView
                android:id="@+id/text_receipt_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tel: 555-0123"
                android:textColor="#000000"
                android:textSize="12sp"
                android:gravity="center"
                android:typeface="monospace" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="********************************"
                android:textColor="#000000"
                android:gravity="center"
                android:typeface="monospace"
                android:layout_marginTop="8dp" />

            <!-- Transaction Info -->
            <TextView android:id="@+id/text_receipt_id" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TRX: #0001" android:textSize="12sp" android:textColor="#000000" android:typeface="monospace"/>
            <TextView android:id="@+id/text_receipt_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="2023-01-01 12:00:00" android:textSize="12sp" android:textColor="#000000" android:typeface="monospace"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--------------------------------"
                android:textColor="#000000"
                android:gravity="center"
                android:typeface="monospace" />

            <!-- Item List Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:text="QTY" android:textSize="12sp" android:textStyle="bold" android:typeface="monospace" android:textColor="#000000"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ITEM" android:textSize="12sp" android:textStyle="bold" android:typeface="monospace" android:textColor="#000000"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PRICE" android:textSize="12sp" android:textStyle="bold" android:typeface="monospace" android:textColor="#000000"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--------------------------------"
                android:textColor="#000000"
                android:gravity="center"
                android:typeface="monospace" />

            <!-- Item List -->
            <LinearLayout
                android:id="@+id/receipt_items_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--------------------------------"
                android:textColor="#000000"
                android:gravity="center"
                android:typeface="monospace" />

            <!-- Totals -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="TOTAL" android:textStyle="bold" android:textSize="16sp" android:textColor="#000000" android:typeface="monospace"/>
                <TextView android:id="@+id/text_receipt_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₱0.00" android:textStyle="bold" android:textSize="16sp" android:textColor="#000000" android:typeface="monospace"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="CASH" android:textSize="14sp" android:textColor="#000000" android:typeface="monospace"/>
                <TextView android:id="@+id/text_receipt_paid" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₱0.00" android:textSize="14sp" android:textColor="#000000" android:typeface="monospace"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="CHANGE" android:textSize="14sp" android:textColor="#000000" android:typeface="monospace"/>
                <TextView android:id="@+id/text_receipt_change" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₱0.00" android:textSize="14sp" android:textColor="#000000" android:typeface="monospace"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--------------------------------"
                android:textColor="#000000"
                android:gravity="center"
                android:typeface="monospace"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/text_receipt_seller"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Seller: Owner"
                android:textColor="#000000"
                android:textSize="12sp"
                android:gravity="center"
                android:typeface="monospace" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="THANK YOU!"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:typeface="monospace" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Please come again"
                android:textColor="#000000"
                android:textSize="10sp"
                android:gravity="center"
                android:typeface="monospace" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="********************************"
                android:textColor="#000000"
                android:gravity="center"
                android:typeface="monospace"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Buttons -->
    <LinearLayout
        android:id="@+id/receipt_button_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#F5F5F5">

        <Button
            android:id="@+id/btn_done"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="DONE"
            android:background="@drawable/btn_black"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginRight="8dp" />

        <Button
            android:id="@+id/btn_print"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="2"
            android:text="PRINT RECEIPT"
            android:background="@drawable/btn_blue"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
