<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp"
    android:background="#FFFFFF"
    tools:ignore="RtlHardcoded,UnusedResources">

    <ImageView
        android:id="@+id/productImage"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginRight="10dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_launcher"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Top Row: Name and Sold Price -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/barcode_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#333333"
                android:text="@string/placeholder_product_name"
                android:singleLine="false"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/sold_price_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#3F51B5"
                android:text="@string/placeholder_price" />
        </LinearLayout>

        <!-- Middle Row: Icon, Cost Price, Qty, Low Stock -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tag_icon"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/unit_price_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#E91E63"
                android:text="@string/placeholder_price" />

            <TextView
                android:id="@+id/stock_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:text="@string/placeholder_qty" />

            <TextView
                android:id="@+id/low_stock_alert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="@string/low_stock_warning"
                android:textColor="#F44336"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Bottom Row: Total Value -->
        <TextView
            android:id="@+id/total_value_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#4CAF50"
            android:text="@string/placeholder_total" />

    </LinearLayout>

    <View
        android:id="@+id/deleteView"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="8dp"
        android:background="@android:drawable/ic_menu_close_clear_cancel"
        tools:ignore="NewApi"
        android:backgroundTint="#F44336" />

    <View
        android:id="@+id/optionView"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="8dp"
        android:background="@drawable/edit" />

</LinearLayout>
