<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/finance_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Header Bar with Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#3F51B5">

        <Button
            android:id="@+id/btn_expense_tab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/expense_caps"
            android:textColor="#FFFFFF"
            android:background="?android:attr/selectableItemBackground"
            android:padding="16dp"/>

        <Button
            android:id="@+id/btn_income_tab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/income_caps"
            android:textColor="#FFFFFF"
            android:background="?android:attr/selectableItemBackground"
            android:padding="16dp"
            android:alpha="0.7"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/finance_main_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <GridView
            android:id="@+id/categoryGridView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="4"
            android:padding="8dp"
            android:horizontalSpacing="4dp"
            android:verticalSpacing="12dp"
            android:stretchMode="columnWidth"
            android:gravity="center" />
    </LinearLayout>

</LinearLayout>
