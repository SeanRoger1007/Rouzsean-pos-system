<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D"
    tools:ignore="RtlHardcoded,RtlSymmetry">

    <!-- Background Image with Overlay -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.25"
        android:src="@drawable/bg_logo" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#AA000000" />

    <LinearLayout
        android:id="@+id/home_main_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Fade-in Group Start -->
        <TextView
            android:id="@+id/home_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="@string/store_overview"
            android:textColor="#D4AF37"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.25" />

        <TextView
            android:id="@+id/clock_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="00:00:00"
            android:textColor="#BBBBBB"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <FrameLayout
            android:id="@+id/chart_wrapper"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="@drawable/product_card_bg"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/chart_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical" />

            <View
                android:id="@+id/chart_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/chart_dot"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/chart_detail_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Drag across the graph to see details"
            android:textColor="#66D4AF37"
            android:textSize="11sp"
            android:textStyle="italic" />
        <!-- Fade-in Group End -->

        <!-- Period Switcher -->
        <LinearLayout
            android:id="@+id/period_switcher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_daily"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:text="DAILY"
                android:textSize="10sp"
                android:background="#333333"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btn_weekly"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:text="WEEKLY"
                android:textSize="10sp"
                android:background="#1A1A1A"
                android:textColor="#999999"
                android:layout_marginLeft="4dp" />

            <Button
                android:id="@+id/btn_monthly"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:text="MONTHLY"
                android:textSize="10sp"
                android:background="#1A1A1A"
                android:textColor="#999999"
                android:layout_marginLeft="4dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/date_nav_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1A1A1A"
            android:padding="4dp">

            <Button
                android:id="@+id/btn_prev"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="&lt;"
                android:background="#333333"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/text_date_display"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="TODAY"
                android:textColor="#D4AF37"
                android:textStyle="bold"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_next"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="&gt;"
                android:background="#333333"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/cards_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Sales Card (Left) -->
                <LinearLayout
                    android:id="@+id/card_sales"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/card_button_bg"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📊" android:textSize="20sp" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginLeft="12dp"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TOTAL REVENUE" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">
                                <TextView android:id="@+id/text_cash_profit_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cash: ₱0.00" android:textColor="#999999" android:textSize="11sp" />
                                <TextView android:id="@+id/text_gcash_profit_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="10dp" android:text="GCash: ₱0.00" android:textColor="#999999" android:textSize="11sp" />
                            </LinearLayout>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tap to view ➜" android:textColor="#66D4AF37" android:textSize="10sp" />
                    </LinearLayout>

                    <TextView android:id="@+id/text_total_price" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="₱0.00" android:textColor="#D4AF37" android:textSize="26sp" android:textStyle="bold" android:gravity="right" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp"
                        android:gravity="right">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Profits: " android:textColor="#999999" android:textSize="12sp" />
                        <TextView android:id="@+id/text_total_income_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₱0.00" android:textColor="#4CAF50" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Expenses Card (Right) -->
                <LinearLayout
                    android:id="@+id/card_expenses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/card_button_bg"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💸" android:textSize="20sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:text="TOTAL EXPENSES" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tap to view ➜" android:textColor="#66D4AF37" android:textSize="10sp" android:gravity="right" />
                    </LinearLayout>
                    <TextView android:id="@+id/text_expenses_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="₱0.00" android:textColor="#FF5252" android:textSize="26sp" android:textStyle="bold" android:gravity="right" />
                </LinearLayout>

                <!-- Stock Value Card (Left) -->
                <LinearLayout
                    android:id="@+id/card_stock_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/card_button_bg"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📦" android:textSize="20sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:text="INVENTORY VALUE" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
                    </LinearLayout>
                    <TextView android:id="@+id/text_stock_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="₱0.00" android:textColor="#2196F3" android:textSize="26sp" android:textStyle="bold" android:gravity="right" />
                </LinearLayout>

                <!-- Cash Register Card (Right) -->
                <LinearLayout
                    android:id="@+id/card_store_capital"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/card_button_bg"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏦" android:textSize="20sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:text="CASH ON HAND" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tap to edit ✎" android:textColor="#66D4AF37" android:textSize="10sp" android:gravity="right" />
                    </LinearLayout>
                    <TextView android:id="@+id/text_store_capital_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="₱0.00" android:textColor="#4CAF50" android:textSize="26sp" android:textStyle="bold" android:gravity="right" />
                </LinearLayout>

                <!-- GCash Balance Card (Left) -->
                <LinearLayout
                    android:id="@+id/card_gcash_balance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/card_button_bg"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📱" android:textSize="20sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:text="GCASH BALANCE" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tap to edit ✎" android:textColor="#66D4AF37" android:textSize="10sp" android:gravity="right" />
                    </LinearLayout>
                    <TextView android:id="@+id/text_gcash_balance_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="₱0.00" android:textColor="#03A9F4" android:textSize="26sp" android:textStyle="bold" android:gravity="right" />
                </LinearLayout>

                <!-- Staff Today Card (Right) -->
                <LinearLayout
                    android:id="@+id/card_staff_today"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/card_button_bg"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👥" android:textSize="20sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:text="STAFF ON DUTY" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
                    </LinearLayout>
                    <TextView android:id="@+id/text_staff_today_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="None" android:textColor="#E91E63" android:textSize="18sp" android:textStyle="bold" android:gravity="right" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

</RelativeLayout>
